# Скопировать в .env (он в .gitignore) и заполнить. Значения передаёт владелец
# проекта лично — в репозитории их нет и быть не должно.

# Ключ счётчика устройств. Без него сборка проходит, но счётчик устройств на
# главном экране молча пропадает — scripts/build_android.sh без ключа не соберёт.
DEVICE_API_KEY=
