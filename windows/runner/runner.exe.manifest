<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
  <!-- Уровень намеренно `asInvoker`, хотя дефолтный режим службы на Windows —
       VPN (TUN), которому нужны права администратора.

       С `requireAdministrator` отказ в окне UAC означал бы, что приложение не
       запускается вообще: нажал «Нет» — и вместо окна ничего. Поэтому право
       запрашивается не манифестом, а самим процессом при старте
       (`main.cpp`, RelaunchElevated). Отказ там не фатален: процесс продолжает
       работу в ограниченном режиме, получает аргумент no-admin с двумя ведущими дефисами
       (написать их здесь буквально нельзя: два дефиса подряд в XML-комментарии
       запрещены спецификацией, и mt.exe отвергает такой манифест), показывает
       плашку и работает системным прокси, пока пользователь не перезапустит
       приложение с правами кнопкой в этой плашке. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
    </application>
  </compatibility>
</assembly>
